spring:
  application:
    name: ${name-of-your-project}
  datasource:
    url: ${DB_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
  jpa:
    hibernate:
      ddl-auto: update #can be changed to validate
  show-sql: true
  properties:
    hibernate:
      format_sql: true

server:
  port: 8080

app:
  jwt:
    secret: %{jwt.secret}
    expiration: ${jwt.expiration.millis}

logging:
  level:
    org.springframework.security: DEBUG
    org.hibernate.SQL: DEBUG
    org.hibernate.orm.results: DEBUG